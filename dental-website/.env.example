# Local PostgreSQL connection. Use a disposable development database.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5433/dental_db?schema=public

# NextAuth
NEXTAUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXTAUTH_URL=http://localhost:3000

# Public Google Analytics measurement ID (not a credential)
NEXT_PUBLIC_GA_ID=

# Server-only GA4/GSC proxy to the paired FastAPI service
ANALYTICS_BACKEND_URL=http://localhost:8000
ANALYTICS_API_TOKEN=replace-with-the-same-random-secret-at-least-32-characters

# Google service account settings for backend deployment only
GA_PROPERTY_ID=
GSC_PROPERTY_URL=
GOOGLE_CREDENTIALS_JSON=
FRONTEND_ORIGINS=http://localhost:3000

# Optional email settings
EMAIL_FROM=
EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Site configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-time bootstrap only; remove after creating the first administrator
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
